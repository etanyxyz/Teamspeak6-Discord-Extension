# --- TeamSpeak 6 server (SSH ServerQuery) ---
# Host the bridge connects to (service name when running via docker compose).
TS_HOST=ts6
# SSH ServerQuery port (TS6 ships 10022; verify against your server's log).
TS_SSH_PORT=10022
# Query login (from the TS6 server's first-start output / admin UI).
TS_QUERY_USER=serveradmin
# Query password (from the TS6 server's first-start output / admin UI).
TS_QUERY_PASSWORD=change-me
# WebQuery API key (first-start output). Only needed if you use the HTTP
# interface manually; the bridge itself uses the SSH interface.
TS_QUERY_API_KEY=
# Nickname the bridge's query client uses on the TS server.
BRIDGE_NICKNAME=TS6-Discord-Bridge
# Channel (by name) the bridge's query client sits in. Channel chat is only
# visible from that channel (see docs/sample-events.txt). Empty = the
# server's default channel.
TS_BRIDGE_CHANNEL=

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000/0000

# --- Behaviour ---
# Forward private messages (default false). Note: TS6 rejects private
# messages sent BY query clients, so at best only privates addressed to
# the bridge's own query client could be captured (unverified in beta14).
FORWARD_PRIVATE_MESSAGES=false
# Comma-separated list of unique IDs to ignore (connect/leave/chat).
IGNORE_CLIENT_UIDS=
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
