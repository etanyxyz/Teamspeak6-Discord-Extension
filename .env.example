# --- TeamSpeak 6 server ---
# Host the bridge connects to (service name when running via docker compose).
TS_HOST=ts6
# ServerQuery port (raw TCP). TS6: verify against your server's ports.conf.
TS_QUERY_PORT=10011
# Query login (from the TS6 server admin UI / first-start output).
TS_QUERY_USER=admin
# Query password (or API key if TS6 uses one).
TS_QUERY_PASSWORD=change-me
# Optional: unique ID used to identify the bridge's own query client,
# so its own connect/disconnect events are not forwarded.
TS_BRIDGE_UID=

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000/0000

# --- Behaviour ---
# Forward private messages between other users (default false).
FORWARD_PRIVATE_MESSAGES=false
# Comma-separated list of unique IDs to ignore (connect/leave/chat).
IGNORE_CLIENT_UIDS=
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
